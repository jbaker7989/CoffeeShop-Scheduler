# Invitation acceptance lifetime in seconds (default 72 hours).
INVITE_TTL=259200
# Invitation delivery is intentionally log/no-op in CS-061c; links are returned in dev/test.
INVITATION_NOTIFIER_MODE=log

# --- CS-062 tenant onboarding ---
# Trial is usable immediately; a nightly auth_svc job suspends it after this many days.
TRIAL_DAYS=14
# Verification delivery is a dev/test URL stub in this slice.
VERIFICATION_TTL=3600

# --- CS-070 tenant routing (opt-in) ---
# Routing is OFF by default so the single-tenant demo keeps the CS-030/CS-061 same-origin
# behavior (BUG-056). Set to true only once the manager UI uses /t/<slug>/ (dev) or
# subdomains (prod); otherwise the gateway 404s the shell's unprefixed /me, /stores, /auth/login.
TENANT_ROUTING_ENABLED=false
# production | development
TENANT_ROUTING_MODE=development
# Prod subdomain suffix: <slug>.<suffix>
TENANT_PLATFORM_SUFFIX=coffeescheduler.com
TENANT_DEVELOPMENT_HOST=localhost
TENANT_DEVELOPMENT_PREFIX=/t/
# REQUIRED when routing is enabled behind the Next proxy, or the per-client IP throttle
# collapses to the proxy IP (BUG-057). Comma-separated CIDRs of the trusted Next/ingress hop.
TRUSTED_PROXY_CIDRS=
