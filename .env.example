# Pooled application connection: PgBouncer on 127.0.0.1:6432 in transaction mode.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@127.0.0.1:6432/APP_DATABASE

# Direct migration connection: Alembic uses Postgres on 127.0.0.1:5432 because DDL and
# advisory locks are not pooling-safe.
DATABASE_URL_DIRECT=postgresql+psycopg://MIGRATOR_USER:MIGRATOR_PASSWORD@127.0.0.1:5432/APP_DATABASE

# Real per-tenant secrets live in the encrypted tenant_secrets table (F63), never in .env.

# --- CS-061a (F61) tenant authentication ---
# Dedicated auth-service connection: auth_svc remains a NOLOGIN least-privilege role and
# is the ONLY role granted EXECUTE on the auth_* SECURITY DEFINER functions. Provision a
# separately provisioned LOGIN principal for this URL, then grant it membership with
# `GRANT auth_svc TO AUTH_LOGIN_USER`; AUTH_DATABASE_URL must never use app_rw, app_ro,
# or the coffeeshop superuser URL.
AUTH_DATABASE_URL=postgresql://AUTH_LOGIN_USER:AUTH_LOGIN_PASSWORD@127.0.0.1:5432/APP_DATABASE

# RS256 access-token keyring. Private signing key (PEM), a JSON object mapping kid -> public
# PEM, and the active signing kid. PEM material is read at load and is never committed.
AUTH_JWT_PRIVATE_KEY_PEM=
AUTH_JWT_PUBLIC_KEYS_PEM={"KID_2026_01":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
AUTH_JWT_ACTIVE_KID=KID_2026_01
AUTH_JWT_ISSUER=https://auth.coffee-scheduler.example
AUTH_JWT_AUDIENCE=coffee-scheduler

# Server-side pepper for refresh-token digests (>= 32 bytes of high-entropy secret).
AUTH_REFRESH_PEPPER=
